# ============================================================
# APP / BUILD
# ============================================================
VITE_APP_NAME="My App"
VITE_APP_ENV="development"          # development | staging | production
VITE_APP_VERSION="1.0.0"
VITE_APP_URL="http://localhost:5173"
VITE_APP_DEFAULT_LOCALE="en"
VITE_APP_SUPPORT_EMAIL="support@example.com"

# ============================================================
# API / BACKEND
# ============================================================
VITE_API_URL="http://localhost:3000/api"
VITE_API_TIMEOUT_MS="15000"
VITE_WS_URL="ws://localhost:3000"          # websocket / realtime endpoint
VITE_GRAPHQL_URL=""                        # if using GraphQL instead of/alongside REST

# ============================================================
# AUTH
# ============================================================
VITE_AUTH_DOMAIN=""                        # e.g. Auth0/Clerk domain
VITE_AUTH_CLIENT_ID=""
VITE_AUTH_REDIRECT_URI=""
VITE_GOOGLE_CLIENT_ID=""                   # OAuth — public client IDs only
VITE_FACEBOOK_APP_ID=""
VITE_APPLE_CLIENT_ID=""

# ============================================================
# MEDIA / STORAGE / CDN
# ============================================================
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""           # unsigned preset only — never a secret key here
VITE_S3_BUCKET_URL=""
VITE_CDN_URL=""
VITE_ASSETS_URL=""

# ============================================================
# PAYMENTS
# ============================================================
VITE_STRIPE_PUBLISHABLE_KEY=""             # publishable key only, never the secret key
VITE_PAYPAL_CLIENT_ID=""

# ============================================================
# MAPS / LOCATION
# ============================================================
VITE_GOOGLE_MAPS_API_KEY=""
VITE_MAPBOX_TOKEN=""

# ============================================================
# ANALYTICS / TRACKING
# ============================================================
VITE_GA_MEASUREMENT_ID=""                  # Google Analytics
VITE_GTM_ID=""                             # Google Tag Manager
VITE_MIXPANEL_TOKEN=""
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST=""
VITE_HOTJAR_ID=""

# ============================================================
# ERROR TRACKING / MONITORING
# ============================================================
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT=""
VITE_LOGROCKET_APP_ID=""

# ============================================================
# PUSH NOTIFICATIONS / MESSAGING
# ============================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_VAPID_PUBLIC_KEY=""                   # web push

# ============================================================
# FEATURE FLAGS / EXPERIMENTS
# ============================================================
VITE_FEATURE_FLAG_PROVIDER=""              # e.g. launchdarkly, flagsmith, unleash
VITE_LAUNCHDARKLY_CLIENT_ID=""
VITE_ENABLE_BETA_FEATURES="false"

# ============================================================
# THIRD-PARTY WIDGETS
# ============================================================
VITE_INTERCOM_APP_ID=""
VITE_CRISP_WEBSITE_ID=""
VITE_RECAPTCHA_SITE_KEY=""
VITE_ALGOLIA_APP_ID=""
VITE_ALGOLIA_SEARCH_KEY=""                 # search-only public key

# ============================================================
# SOCIAL / SHARING
# ============================================================
VITE_TWITTER_HANDLE=""
VITE_OG_IMAGE_URL=""                       # default social share image
